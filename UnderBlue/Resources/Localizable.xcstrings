    "Export cancelled because UnderBlue went into the background. Keep the app open and try again. Your trial hasn’t been used." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Export cancelled because UnderBlue went into the background. Keep the app open and try again. Your trial hasn’t been used."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "UnderBlueがバックグラウンドに移ったため、書き出しをキャンセルしました。アプリを開いたまま、もう一度お試しください。無料枠は使用されていません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "UnderBlue가 백그라운드로 전환되어 내보내기가 취소되었습니다. 앱을 열어 둔 채 다시 시도하세요. 무료 이용권은 차감되지 않았습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "UnderBlue 进入后台，因此导出已取消。请保持应用打开后重试。免费额度未被使用。"
          }
        },
        "zh-Hant" : {
