{
  "sourceLanguage": "en",
  "strings": {
    "1 photo export. This uses your free photo.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1 photo export. This uses your free photo."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무료 사진 내보내기 1회입니다. 이번 내보내기에 무료 이용권을 사용합니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真を1枚無料で書き出せます。この書き出しで無料枠を使用します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可免费导出 1 张照片。本次导出将使用免费额度。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可免費匯出 1 張照片。本次匯出將使用免費額度。"
          }
        }
      }
    },
    "1 video export · first 10 seconds · up to 1080p SDR. This uses your free video.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1 video export · first 10 seconds · up to 1080p SDR. This uses your free video."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무료 동영상 내보내기 1회 · 처음 10초 · 최대 1080p SDR입니다. 이번 내보내기에 무료 이용권을 사용합니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "動画を1本無料で書き出せます · 冒頭10秒 · 最大1080p SDR。この書き出しで無料枠を使用します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可免费导出 1 个视频 · 前 10 秒 · 最高 1080p SDR。本次导出将使用免费额度。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可免費匯出 1 部影片 · 前 10 秒 · 最高 1080p SDR。本次匯出將使用免費額度。"
          }
        }
      }
    },
