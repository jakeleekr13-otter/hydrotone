    "All processing stays on your iPhone. No account or subscription.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All processing stays on your iPhone. No account or subscription."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 처리는 iPhone에서 이루어집니다. 계정이나 구독이 필요하지 않습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての処理はiPhone上で行われます。アカウントやサブスクリプションは不要です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有处理都在 iPhone 上完成。无需账户或订阅。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所有處理都在 iPhone 上完成。無需帳號或訂閱。"
          }
        }
      }
    },
    "Allow HydroTone to add to Photos in Settings, then try saving again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow HydroTone to add to Photos in Settings, then try saving again."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정에서 HydroTone이 사진에 추가하도록 허용한 후 다시 저장하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定でHydroToneによる写真への追加を許可してから、もう一度保存してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在“设置”中允许 HydroTone 添加到照片，然后再次保存。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在「設定」中允許 HydroTone 加入照片，然後再次儲存。"
          }
        }
      }
    },
    "Bring back\nthe dive.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bring back\nthe dive."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "수중 촬영물의 잃어버린 색을\n찾으세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダイビングの色を\n取り戻そう。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "找回潜水时的\n真实色彩。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "找回潛水時的\n真實色彩。"
          }
        }
      }
    },
