      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "4K export"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "4K 내보내기"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
