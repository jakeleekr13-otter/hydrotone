    "Diagnostics stay on this iPhone. Nothing is sent automatically.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Diagnostics stay on this iPhone. Nothing is sent automatically."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "진단 정보는 이 iPhone에만 저장됩니다. 자동으로 전송되는 정보는 없습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "診断情報はこのiPhone内に保存されます。自動送信は行いません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "诊断信息仅保存在此 iPhone 上，不会自动发送。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "診斷資訊只會儲存在此 iPhone，不會自動傳送。"
          }
        }
      }
    },
